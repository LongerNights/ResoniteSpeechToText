<Project>
  <!--
    Copy this file to Local.props (git-ignored) and set the folder that contains Resonite.exe.
    Alternatives: pass -p:ResonitePath="..." to dotnet build, or set the RESONITE_PATH environment variable.
  -->
  <PropertyGroup>
    <ResonitePath>C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
  </PropertyGroup>
</Project>
